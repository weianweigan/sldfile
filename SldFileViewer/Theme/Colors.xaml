<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light CAD Workspace Colors -->
    <Color x:Key="Color.Background.Primary">#FFFFFF</Color>
    <Color x:Key="Color.Background.Secondary">#F8F9FA</Color>
    <Color x:Key="Color.Background.Tertiary">#F1F3F5</Color>
    <Color x:Key="Color.Background.Hover">#E9ECEF</Color>
    <Color x:Key="Color.Background.Selected">#CCE4F7</Color>

    <!-- Canvas CAD Viewport Gradient (Clean CAD Technical Light Gradient) -->
    <Color x:Key="Color.Viewport.Top">#EDF2F7</Color>
    <Color x:Key="Color.Viewport.Bottom">#CBD5E1</Color>
    <Color x:Key="Color.Viewport.Grid">#E2E8F0</Color>
    <Color x:Key="Color.Viewport.Origin">#E53E3E</Color>

    <!-- Borders and Separators -->
    <Color x:Key="Color.Border.Primary">#D8DEE4</Color>
    <Color x:Key="Color.Border.Light">#E9ECEF</Color>
    <Color x:Key="Color.Border.Focus">#0066CC</Color>

    <!-- Typography -->
    <Color x:Key="Color.Text.Primary">#1E293B</Color>
    <Color x:Key="Color.Text.Secondary">#475569</Color>
    <Color x:Key="Color.Text.Muted">#94A3B8</Color>
    <Color x:Key="Color.Text.Accent">#0066CC</Color>

    <!-- Brand and Status Accents -->
    <Color x:Key="Color.Accent.Blue">#0066CC</Color>
    <Color x:Key="Color.Accent.BlueHover">#0052A3</Color>
    <Color x:Key="Color.Accent.Green">#16A34A</Color>
    <Color x:Key="Color.Accent.Yellow">#D97706</Color>
    <Color x:Key="Color.Accent.Red">#DC2626</Color>
    <Color x:Key="Color.Accent.Orange">#EA580C</Color>

    <!-- CAD Sketch Primitives Colors -->
    <Color x:Key="Color.Sketch.NormalSegment">#0066CC</Color>
    <Color x:Key="Color.Sketch.ConstructionSegment">#D97706</Color>
    <Color x:Key="Color.Sketch.Point">#DC2626</Color>
    <Color x:Key="Color.Sketch.PointHover">#EF4444</Color>
    <Color x:Key="Color.Sketch.Selected">#10B981</Color>
    <Color x:Key="Color.Sketch.Dimension">#6366F1</Color>
    <Color x:Key="Color.Sketch.ConstraintBadge">#16A34A</Color>
    <Color x:Key="Color.Sketch.ConstraintText">#FFFFFF</Color>

    <!-- 3D Model Render Colors -->
    <Color x:Key="Color.Mesh.DefaultFace">#94A3B8</Color>
    <Color x:Key="Color.Mesh.OutlineEdge">#334155</Color>

</ResourceDictionary>
