<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- Figma Design System Tokens (per Design.md)                                -->
    <!-- ========================================================================= -->

    <!-- Monochrome System Core -->
    <Color x:Key="Color.Figma.Primary">#000000</Color>
    <Color x:Key="Color.Figma.OnPrimary">#FFFFFF</Color>
    <Color x:Key="Color.Figma.Ink">#000000</Color>
    <Color x:Key="Color.Figma.Canvas">#FFFFFF</Color>
    <Color x:Key="Color.Figma.InverseCanvas">#000000</Color>
    <Color x:Key="Color.Figma.InverseInk">#FFFFFF</Color>
    <Color x:Key="Color.Figma.OnInverseSoft">#26FFFFFF</Color>

    <!-- Hairline and Surface Neutrals -->
    <Color x:Key="Color.Figma.Hairline">#D1D1D1</Color>
    <Color x:Key="Color.Figma.HairlineSoft">#F1F1F1</Color>
    <Color x:Key="Color.Figma.SurfaceSoft">#E9E9E9</Color>
    <Color x:Key="Color.Figma.SurfaceCanvas">#FAFAFA</Color>

    <!-- Signature Pastel Color Blocks -->
    <Color x:Key="Color.Figma.BlockLime">#DCEEB1</Color>
    <Color x:Key="Color.Figma.BlockLilac">#C5B0F4</Color>
    <Color x:Key="Color.Figma.BlockCream">#F4ECD6</Color>
    <Color x:Key="Color.Figma.BlockPink">#EFD4D4</Color>
    <Color x:Key="Color.Figma.BlockMint">#C8E6CD</Color>
    <Color x:Key="Color.Figma.BlockCoral">#F3C9B6</Color>
    <Color x:Key="Color.Figma.BlockNavy">#1F1D3D</Color>

    <!-- Accent and Semantic -->
    <Color x:Key="Color.Figma.AccentMagenta">#FF3D8B</Color>
    <Color x:Key="Color.Figma.SemanticSuccess">#1EA64A</Color>
    <Color x:Key="Color.Figma.OverlayScrim">#99000000</Color>

    <!-- ========================================================================= -->
    <!-- Mapped Application Colors (Backwards Compatible + Refactored to Design.md) -->
    <!-- ========================================================================= -->

    <!-- Workspace Surfaces -->
    <Color x:Key="Color.Background.Primary">#FFFFFF</Color>
    <Color x:Key="Color.Background.Secondary">#FFFFFF</Color>
    <Color x:Key="Color.Background.Tertiary">#F7F7F7</Color>
    <Color x:Key="Color.Background.Hover">#F1F1F1</Color>
    <Color x:Key="Color.Background.Selected">#DCEEB1</Color>

    <!-- 3D Viewport Background (Clean Neutral Studio) -->
    <Color x:Key="Color.Viewport.Top">#FFFFFF</Color>
    <Color x:Key="Color.Viewport.Bottom">#F4F4F4</Color>
    <Color x:Key="Color.Viewport.Grid">#E9E9E9</Color>
    <Color x:Key="Color.Viewport.Origin">#000000</Color>

    <!-- Borders and Separators -->
    <Color x:Key="Color.Border.Primary">#D1D1D1</Color>
    <Color x:Key="Color.Border.Light">#F1F1F1</Color>
    <Color x:Key="Color.Border.Focus">#000000</Color>

    <!-- Typography -->
    <Color x:Key="Color.Text.Primary">#000000</Color>
    <Color x:Key="Color.Text.Secondary">#262626</Color>
    <Color x:Key="Color.Text.Muted">#757575</Color>
    <Color x:Key="Color.Text.Accent">#000000</Color>

    <!-- Brand and Status Accents -->
    <Color x:Key="Color.Accent.Blue">#000000</Color>
    <Color x:Key="Color.Accent.BlueHover">#262626</Color>
    <Color x:Key="Color.Accent.Green">#1EA64A</Color>
    <Color x:Key="Color.Accent.Yellow">#D97706</Color>
    <Color x:Key="Color.Accent.Red">#DC2626</Color>
    <Color x:Key="Color.Accent.Orange">#EA580C</Color>

    <!-- CAD Sketch Primitives Colors -->
    <Color x:Key="Color.Sketch.NormalSegment">#000000</Color>
    <Color x:Key="Color.Sketch.ConstructionSegment">#D97706</Color>
    <Color x:Key="Color.Sketch.Point">#000000</Color>
    <Color x:Key="Color.Sketch.PointHover">#FF3D8B</Color>
    <Color x:Key="Color.Sketch.Selected">#1EA64A</Color>
    <Color x:Key="Color.Sketch.Dimension">#000000</Color>
    <Color x:Key="Color.Sketch.ConstraintBadge">#DCEEB1</Color>
    <Color x:Key="Color.Sketch.ConstraintText">#000000</Color>

    <!-- 3D Model Render Colors -->
    <Color x:Key="Color.Mesh.DefaultFace">#C4C8CC</Color>
    <Color x:Key="Color.Mesh.OutlineEdge">#000000</Color>

</ResourceDictionary>
