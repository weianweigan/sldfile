<Window x:Class="SldFileViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:views="clr-namespace:SldFileViewer.Views"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="Assets/logo.png"
        Height="780" Width="1240"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Figma.Canvas}"
        Foreground="{StaticResource Brush.Figma.Ink}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Command & Tool Bar (Figma top-nav) -->
            <RowDefinition Height="Auto" />
            <!-- Loading Indicator Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area (Left Tree + Right Views) -->
            <RowDefinition Height="*" />
            <!-- Bottom Marquee Status Strip (Figma marquee-strip) -->
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Top Tool Bar (Figma top-nav: pure white canvas, hairline bottom border) -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Figma.Canvas}"
                BorderBrush="{StaticResource Brush.Figma.Hairline}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- App Logo / Title -->
                    <Image Source="Assets/logo.png"
                           Width="24" Height="24"
                           Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="SolidWorks 文件解析器"
                               FontWeight="Bold" FontSize="15"
                               Foreground="{StaticResource Brush.Figma.Ink}"
                               VerticalAlignment="Center" />

                    <Rectangle Width="1" Height="20" Fill="{StaticResource Brush.Figma.Hairline}" Margin="16,0" />

                    <!-- Open File CTA: Primary Black Pill (Design.md: button-primary) -->
                    <Button Command="{Binding OpenFileCommand}"
                            Style="{StaticResource Style.Button.Primary}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FolderOpenOutline" Foreground="White" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="打开文件..." />
                        </StackPanel>
                    </Button>

                    <!-- Close File: Secondary White Pill (Design.md: button-secondary) -->
                    <Button Command="{Binding CloseFileCommand}"
                            Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource Style.Button.Secondary}"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Close" Foreground="{StaticResource Brush.Figma.Ink}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="关闭文档" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Configuration Switcher Pill -->
                    <Border Visibility="{Binding HasConfigurations, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{StaticResource Brush.Figma.SurfaceCanvas}"
                            BorderBrush="{StaticResource Brush.Figma.Hairline}"
                            BorderThickness="1" CornerRadius="10"
                            Height="28" Margin="12,0,0,0" Padding="8,0,4,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="TuneVariant"
                                                        Foreground="{StaticResource Brush.Accent.Orange}"
                                                        Width="13" Height="13" Margin="0,0,6,0"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="配置: "
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.75"
                                       VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding Configurations}"
                                      SelectedItem="{Binding SelectedConfiguration}"
                                      DisplayMemberPath="Name"
                                      MinWidth="120" Height="24"
                                      BorderThickness="0" Background="Transparent"
                                      FontSize="11" FontWeight="SemiBold"
                                      Foreground="{StaticResource Brush.Figma.Ink}"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Cursor="Hand" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Document Info on the right (Figma pastel cream badge) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Visibility="{Binding IsFileLoaded, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{StaticResource Brush.Figma.BlockCream}"
                            BorderBrush="{StaticResource Brush.Figma.BlockCream}"
                            BorderThickness="1" CornerRadius="10"
                            Padding="14,4">
                        <TextBlock Text="{Binding DocumentInfo}"
                                   FontWeight="SemiBold" FontSize="11"
                                   Foreground="{StaticResource Brush.Figma.Ink}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Loading Progress Bar -->
        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Height="2"
                     BorderThickness="0"
                     Foreground="{StaticResource Brush.Figma.Primary}"
                     Background="Transparent"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

        <!-- Main Dock Area (Left Tree + Right Details) -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Left Explorer Tree -->
                <ColumnDefinition Width="290" MinWidth="220" MaxWidth="500" />
                <!-- Grid Splitter -->
                <ColumnDefinition Width="1" />
                <!-- Right Dynamic Details Panel -->
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Tree -->
            <views:DocumentTreeView Grid.Column="0"
                                    DataContext="{Binding DocumentTree}" />

            <!-- Clean Hairline Vertical Splitter -->
            <GridSplitter Grid.Column="1" Width="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource Brush.Figma.Hairline}"
                          ResizeDirection="Columns" />

            <!-- Right Content Host View -->
            <views:ContentHostView Grid.Column="2"/>
        </Grid>

        <!-- Bottom Marquee Status Strip (Design.md: components.marquee-strip, inverse-canvas) -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.Figma.InverseCanvas}"
                Padding="16,0">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                    <TextBlock Text="SLDFILE ENGINE · OFFLINE STANDALONE"
                               FontFamily="Consolas, Cascadia Code, Segoe UI Mono"
                               FontSize="10" FontWeight="Medium"
                               Foreground="{StaticResource Brush.Figma.InverseInk}"
                               Opacity="0.65"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding StatusMessage}"
                           FontFamily="Consolas, Cascadia Code, Segoe UI Mono"
                           FontSize="11" Foreground="{StaticResource Brush.Figma.InverseInk}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
