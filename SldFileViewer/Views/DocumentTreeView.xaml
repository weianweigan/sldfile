<UserControl x:Class="SldFileViewer.Views.DocumentTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:models="clr-namespace:SldFileViewer.Models"
             xmlns:converters="clr-namespace:SldFileViewer.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300">

    <UserControl.Resources>
        <converters:NodeTypeToMaterialIconConverter x:Key="NodeTypeToMaterialIconConverter" />
        <converters:NodeTypeToBrushConverter x:Key="NodeTypeToBrushConverter" />
        <converters:NullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" Invert="True" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Figma.Canvas}">
        <Grid.RowDefinitions>
            <!-- Search Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- Tree Navigation -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Bar (Figma Pill Input) -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Figma.Canvas}"
                BorderBrush="{StaticResource Brush.Figma.Hairline}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Border Background="{StaticResource Brush.Figma.SurfaceCanvas}"
                    BorderBrush="{StaticResource Brush.Figma.Hairline}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="26" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial Kind="Magnify"
                                                Foreground="{StaticResource Brush.Figma.Ink}"
                                                Opacity="0.45"
                                                Width="13" Height="13"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource Brush.Figma.Ink}"
                             VerticalAlignment="Center" Padding="2,0"
                             FontSize="12" />

                    <Button Grid.Column="2"
                            Click="OnClearSearchClick"
                            Style="{StaticResource Style.Button.Toolbar}"
                            Visibility="{Binding FilterText, Converter={StaticResource NullToVisibilityConverter}}"
                            Padding="2" Height="20" Width="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Close" Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.6" Width="10" Height="10" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- Document TreeView -->
        <TreeView Grid.Row="1"
                  ItemsSource="{Binding RootNodes}"
                  SelectedItemChanged="OnTreeViewSelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type models:TreeNodeModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2,2" VerticalAlignment="Center">
                        <!-- Node Icon -->
                        <Grid Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Image Source="{Binding Icon}"
                                   Width="16" Height="16"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVisibilityConverter}}" />
                            <iconPacks:PackIconMaterial Kind="{Binding Kind, Converter={StaticResource NodeTypeToMaterialIconConverter}}"
                                                        Foreground="{Binding Kind, Converter={StaticResource NodeTypeToBrushConverter}}"
                                                        Width="14" Height="14"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                                        Visibility="{Binding Icon, Converter={StaticResource InverseNullToVisibilityConverter}}" />
                        </Grid>

                        <!-- Title -->
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />

                        <!-- Subtitle Badge -->
                        <TextBlock Text="{Binding SubTitle, StringFormat=' ({0})'}"
                                   Visibility="{Binding SubTitle, Converter={StaticResource NullToVisibilityConverter}}"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
