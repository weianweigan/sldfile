<UserControl x:Class="SldFileViewer.Views.DocumentTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:models="clr-namespace:SldFileViewer.Models"
             xmlns:converters="clr-namespace:SldFileViewer.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="300">

    <UserControl.Resources>
        <converters:NodeTypeToMaterialIconConverter x:Key="NodeTypeToMaterialIconConverter" />
        <converters:NodeTypeToBrushConverter x:Key="NodeTypeToBrushConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Background.Secondary}">
        <Grid.RowDefinitions>
            <!-- Search Filter Bar -->
            <RowDefinition Height="Auto" />
            <!-- Tree Navigation -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Search Bar -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Background.Secondary}"
                BorderBrush="{StaticResource Brush.Border.Primary}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Border Background="{StaticResource Brush.Background.Tertiary}"
                    BorderBrush="{StaticResource Brush.Border.Primary}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Height="26">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                    </Grid.ColumnDefinitions>

                    <iconPacks:PackIconMaterial Kind="Magnify"
                                                Foreground="{StaticResource Brush.Text.Muted}"
                                                Width="14" Height="14"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource Brush.Text.Primary}"
                             VerticalAlignment="Center" Padding="2,0" />

                    <Button Grid.Column="2"
                            Click="OnClearSearchClick"
                            Style="{StaticResource Style.Button.Toolbar}"
                            Visibility="{Binding FilterText, Converter={StaticResource NullToVisibilityConverter}}"
                            Padding="2" Height="20" Width="20"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="Close" Foreground="{StaticResource Brush.Text.Muted}" Width="10" Height="10" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <!-- Document TreeView -->
        <TreeView Grid.Row="1"
                  ItemsSource="{Binding RootNodes}"
                  SelectedItemChanged="OnTreeViewSelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type models:TreeNodeModel}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="2,2" VerticalAlignment="Center">
                        <!-- Node Icon -->
                        <iconPacks:PackIconMaterial Kind="{Binding Kind, Converter={StaticResource NodeTypeToMaterialIconConverter}}"
                                                    Foreground="{Binding Kind, Converter={StaticResource NodeTypeToBrushConverter}}"
                                                    Width="14" Height="14"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center" />

                        <!-- Title -->
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="Normal"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   VerticalAlignment="Center" />

                        <!-- Subtitle Badge -->
                        <TextBlock Text="{Binding SubTitle, StringFormat=' ({0})'}"
                                   Visibility="{Binding SubTitle, Converter={StaticResource NullToVisibilityConverter}}"
                                   FontSize="10"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="4,0,0,0" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
