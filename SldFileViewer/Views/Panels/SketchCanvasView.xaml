<UserControl x:Class="SldFileViewer.Views.Panels.SketchCanvasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:SldFileViewer.Controls"
             xmlns:converters="clr-namespace:SldFileViewer.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:DimensionDisplayConverter x:Key="DimensionDisplayConverter" />
        <converters:RelationKindToStringConverter x:Key="RelationKindToStringConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Background.Primary}">
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Canvas Viewport -->
            <RowDefinition Height="*" />
            <!-- Splitter -->
            <RowDefinition Height="5" />
            <!-- Details Table Drawer -->
            <RowDefinition Height="220" MinHeight="100" />
        </Grid.RowDefinitions>

        <!-- Top Sketch Toolbar (Figma Canvas + Hairline) -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Figma.Canvas}"
                BorderBrush="{StaticResource Brush.Figma.Hairline}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="False">
                <!-- Sketch Info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="DrawPen"
                                                Foreground="{StaticResource Brush.Figma.Ink}"
                                                Width="16" Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SketchName}"
                               FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource Brush.Figma.Ink}"
                               VerticalAlignment="Center" />
                    <Border Background="{StaticResource Brush.Figma.BlockMint}"
                            CornerRadius="10"
                            Padding="12,3" Margin="10,0,0,0">
                        <TextBlock Text="{Binding StatusInfo}"
                                   FontWeight="SemiBold"
                                   FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" />
                    </Border>
                    <Border Visibility="{Binding IsPartial, Converter={StaticResource BoolToVisibilityConverter}}"
                            Background="{StaticResource Brush.Figma.BlockPink}"
                            CornerRadius="10"
                            Padding="10,3" Margin="6,0,0,0">
                        <TextBlock Text="部分解码" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" />
                    </Border>
                </StackPanel>

                <!-- Layer Visibility Toggles (Figma Pill Toggles) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource Style.ToggleButton.Toolbar}"
                                  IsChecked="{Binding ShowPoints}"
                                  ToolTip="显示/隐藏草图点"
                                  Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Brush.Figma.Primary}" Margin="0,0,4,0"/>
                            <TextBlock Text="点" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Style.ToggleButton.Toolbar}"
                                  IsChecked="{Binding ShowConstraints}"
                                  ToolTip="显示/隐藏几何约束符号"
                                  Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource Brush.Figma.BlockLime}" CornerRadius="2" Width="10" Height="10" Margin="0,0,4,0">
                                <TextBlock Text="=" FontSize="8" FontWeight="Bold" Foreground="{StaticResource Brush.Figma.Ink}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="约束" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Style.ToggleButton.Toolbar}"
                                  IsChecked="{Binding ShowDimensions}"
                                  ToolTip="显示/隐藏草图尺寸"
                                  Margin="3,0">
                        <TextBlock Text="📐 尺寸" FontSize="11"/>
                    </ToggleButton>

                    <ToggleButton Style="{StaticResource Style.ToggleButton.Toolbar}"
                                  IsChecked="{Binding ShowConstruction}"
                                  ToolTip="显示/隐藏构造线 (辅助线)"
                                  Margin="3,0">
                        <TextBlock Text="┄ 辅助线" FontSize="11"/>
                    </ToggleButton>

                    <Rectangle Width="1" Height="16" Fill="{StaticResource Brush.Figma.Hairline}" Margin="8,0" />

                    <!-- Fit View Button -->
                    <Button Command="{Binding FitViewCommand}"
                            ToolTip="适应窗口居中 (快捷键: 双击右键)"
                            Style="{StaticResource Style.Button.Secondary}"
                            Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="FitToScreenOutline"
                                                        Foreground="{StaticResource Brush.Figma.Ink}"
                                                        Width="12" Height="12"
                                                        Margin="0,0,4,0"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="适应窗口" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2D Interactive Zoomable Canvas -->
        <Grid Grid.Row="1">
            <controls:ZoomableCanvas x:Name="SketchCanvas"
                                     WorldBounds="{Binding Bounds}"
                                     ClipToBounds="True" />

            <!-- Floating Overlay Hint (Figma Pill) -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="16"
                    Background="#E6FFFFFF"
                    BorderBrush="{StaticResource Brush.Figma.Hairline}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,5">
                <TextBlock Text="滚轮缩放 | 中键拖动平移 | 双击右键复位"
                           FontFamily="Consolas, Cascadia Code, Segoe UI"
                           FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" />
            </Border>
        </Grid>

        <!-- Hairline Splitter -->
        <GridSplitter Grid.Row="2" Height="1"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource Brush.Figma.Hairline}"
                      ResizeDirection="Rows" />

        <!-- Details DataGrid Drawer (Figma Canvas) -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.Figma.Canvas}"
                Padding="12,8,12,12">
            <TabControl>
                <!-- Segments Table -->
                <TabItem Header="图元明细 (Segments)">
                    <DataGrid ItemsSource="{Binding Segments}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectedItem="{Binding SelectedSegment, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="图元 ID" Binding="{Binding Id}" Width="75" />
                            <DataGridTextColumn Header="类别" Binding="{Binding KindName}" Width="110" />
                            <DataGridCheckBoxColumn Header="辅助线" Binding="{Binding IsConstruction}" Width="65" />
                            <DataGridTextColumn Header="起点" Binding="{Binding StartPointDisplay}" Width="170" />
                            <DataGridTextColumn Header="终点" Binding="{Binding EndPointDisplay}" Width="170" />
                            <DataGridTextColumn Header="长度" Binding="{Binding LengthDisplay}" Width="95" />
                            <DataGridTextColumn Header="圆心" Binding="{Binding CenterPointDisplay}" Width="160" />
                            <DataGridTextColumn Header="半径" Binding="{Binding RadiusDisplay}" Width="95" />
                            <DataGridTextColumn Header="说明 / 文本" Binding="{Binding Text}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Points Table -->
                <TabItem Header="点表 (Points)">
                    <DataGrid ItemsSource="{Binding Points}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectedItem="{Binding SelectedPoint, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="点 ID" Binding="{Binding Id}" Width="75" />
                            <DataGridTextColumn Header="表索引" Binding="{Binding TableIndex}" Width="80" />
                            <DataGridTextColumn Header="坐标 (X, Y) mm" Binding="{Binding CoordMm}" Width="180" />
                            <DataGridTextColumn Header="X (mm)" Binding="{Binding XInMm}" Width="95" />
                            <DataGridTextColumn Header="Y (mm)" Binding="{Binding YInMm}" Width="95" />
                            <DataGridTextColumn Header="Z (mm)" Binding="{Binding ZInMm}" Width="95" />
                            <DataGridTextColumn Header="X (m)" Binding="{Binding WorldX, StringFormat='F6'}" Width="110" />
                            <DataGridTextColumn Header="Y (m)" Binding="{Binding WorldY, StringFormat='F6'}" Width="110" />
                            <DataGridTextColumn Header="Z (m)" Binding="{Binding WorldZ, StringFormat='F6'}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Constraints Table -->
                <TabItem Header="约束关系 (Relations)">
                    <DataGrid ItemsSource="{Binding Relations}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="约束类型" Binding="{Binding TypeName}" Width="170" />
                            <DataGridTextColumn Header="代码 (TypeCode)" Binding="{Binding TypeCode}" Width="110" />
                            <DataGridTextColumn Header="关联实体" Binding="{Binding EntitiesText}" Width="*" />
                            <DataGridTextColumn Header="关联数" Binding="{Binding EntityCount}" Width="80" />
                            <DataGridTextColumn Header="布局 (Layout)" Binding="{Binding Layout}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Dimensions Table -->
                <TabItem Header="尺寸 (Dimensions)">
                    <DataGrid ItemsSource="{Binding Dimensions}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="尺寸名称" Binding="{Binding Name}" Width="120" />
                            <DataGridTextColumn Header="类别" Binding="{Binding DimensionType}" Width="100" />
                            <DataGridTextColumn Header="数值 / 标注" Binding="{Binding FormattedValue}" Width="130" />
                            <DataGridTextColumn Header="关联图元" Binding="{Binding TargetEntity}" Width="160" />
                            <DataGridTextColumn Header="系统原始值 (m)" Binding="{Binding ValueInMeters, StringFormat='F6'}" Width="120" />
                            <DataGridTextColumn Header="定位坐标 (mm)" Binding="{Binding TextPositionDisplay}" Width="150" />
                            <DataGridTextColumn Header="方向向量" Binding="{Binding DirectionDisplay}" Width="120" />
                            <DataGridTextColumn Header="数值来源" Binding="{Binding ValueSource}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Diagnostics -->
                <TabItem Header="解码诊断 (Diagnostics)">
                    <ListBox ItemsSource="{Binding Diagnostics}"
                             Background="{StaticResource Brush.Background.Secondary}"
                             Foreground="{StaticResource Brush.Text.Secondary}"
                             BorderThickness="0"
                             Padding="6" />
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
