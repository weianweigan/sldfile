<UserControl x:Class="SldFileViewer.Views.Panels.ImagePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:controls="clr-namespace:SldFileViewer.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="{StaticResource Brush.Figma.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Toolbar (Figma Canvas + Hairline) -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Figma.Canvas}"
                BorderBrush="{StaticResource Brush.Figma.Hairline}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <DockPanel LastChildFill="False">
                <!-- Left: Title & Info Badge -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Geo.Drawing}"
                          Fill="{StaticResource Brush.Figma.Ink}"
                          Width="14" Height="14" Stretch="Uniform"
                          Margin="0,0,8,0" />
                    <TextBlock Text="2D 图像与工程图预览 (Preview)"
                               FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource Brush.Figma.Ink}"
                               VerticalAlignment="Center" />

                    <!-- Resolution & Info Badge -->
                    <Border Background="{StaticResource Brush.Figma.BlockLilac}"
                            CornerRadius="10"
                            Padding="10,3" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding ImageInfo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" />
                    </Border>
                </StackPanel>

                <!-- Right: Action Tools & Switch to 3D -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Zoom & Pan Controls (Visible when image is loaded) -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <!-- Fit View -->
                        <Button Command="{Binding FitToWindowCommand}"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Padding="8,4" Margin="2,0"
                                ToolTip="自适应窗口大小 (双击画布 / Ctrl+0)">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FitToScreenOutline" Width="12" Height="12" Foreground="{StaticResource Brush.Figma.Ink}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="适应窗口" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- 100% 1:1 Actual Size -->
                        <Button Command="{Binding ResetTo100Command}"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Padding="8,4" Margin="2,0"
                                ToolTip="1:1 实际物理像素尺寸 (100%)">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AspectRatio" Width="12" Height="12" Foreground="{StaticResource Brush.Figma.Ink}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="100%" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Zoom Out -->
                        <Button Command="{Binding ZoomOutCommand}"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Padding="6,4" Margin="2,0"
                                ToolTip="缩小视图 (或滚轮向下)">
                            <iconPacks:PackIconMaterial Kind="MagnifyMinusOutline" Width="12" Height="12" Foreground="{StaticResource Brush.Figma.Ink}"/>
                        </Button>

                        <!-- Zoom Percent Badge -->
                        <Border Background="{StaticResource Brush.Figma.SurfaceCanvas}"
                                BorderBrush="{StaticResource Brush.Figma.Hairline}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="8,3" Margin="2,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ZoomText}" FontSize="11" FontWeight="SemiBold" Width="38" TextAlignment="Center" Foreground="{StaticResource Brush.Figma.Ink}"/>
                        </Border>

                        <!-- Zoom In -->
                        <Button Command="{Binding ZoomInCommand}"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Padding="6,4" Margin="2,0"
                                ToolTip="放大视图 (或滚轮向上)">
                            <iconPacks:PackIconMaterial Kind="MagnifyPlusOutline" Width="12" Height="12" Foreground="{StaticResource Brush.Figma.Ink}"/>
                        </Button>

                        <!-- Filter Mode Toggle (Fant vs Nearest) -->
                        <Button Command="{Binding ToggleFilterModeCommand}"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Padding="8,4" Margin="2,0"
                                ToolTip="切换图像缩放插值算法 (抗锯齿平滑 / 锐利像素)">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="AutoFix" Width="12" Height="12" Foreground="{StaticResource Brush.Figma.Ink}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FilterModeText}" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <!-- Vector CAD Typography Toggle (Lossless Vector Overlay) -->
                        <Button Command="{Binding CycleOverlayModeCommand}"
                                Visibility="{Binding HasVectorData, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Padding="8,4" Margin="2,0"
                                ToolTip="循环切换工程图渲染模式 (原生工程图 [100%官方渲染] / 全图 CAD / 纯矢量 CAD / 图纸注释增强)">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FormatLetterCase" Width="12" Height="12" Foreground="{StaticResource Brush.Figma.Ink}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding VectorOverlayButtonText}" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Export Image Button -->
                        <Button Command="{Binding ExportImageCommand}"
                                Style="{StaticResource Style.Button.Toolbar}"
                                Padding="8,4" Margin="2,0"
                                ToolTip="导出另存为图片 (PNG / BMP)">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="12" Height="12" Foreground="{StaticResource Brush.Figma.Ink}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="导出图像" FontSize="11"/>
                            </StackPanel>
                        </Button>

                        <Rectangle Width="1" Height="16" Fill="{StaticResource Brush.Figma.Hairline}" Margin="8,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Switch to 3D Button -->
                    <Button Command="{Binding DataContext.SwitchTo3DViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            Visibility="{Binding DataContext.MeshViewer.HasMesh, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource Style.Button.Secondary}"
                            Padding="12,4"
                            ToolTip="切换回 3D 模型网格交互检视器">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CubeOutline" Foreground="{StaticResource Brush.Figma.Ink}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="3D 模型网格" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Interactive Zoom & Pan Viewport -->
        <Grid Grid.Row="1"
              x:Name="ViewportContainer"
              Background="{StaticResource Brush.Figma.SurfaceCanvas}"
              ClipToBounds="True"
              Focusable="True"
              MouseWheel="OnViewportMouseWheel"
              MouseDown="OnViewportMouseDown"
              MouseMove="OnViewportMouseMove"
              MouseUp="OnViewportMouseUp"
              SizeChanged="OnViewportSizeChanged">

            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="📐 工程图渲染模式 (CAD 引擎)" Visibility="{Binding HasVectorData, Converter={StaticResource BoolToVisibilityConverter}}">
                        <MenuItem Header="📐 原生工程图 (推荐，100% 官方渲染保真)" Command="{Binding SetOverlayOffModeCommand}" />
                        <MenuItem Header="🔤 图纸注释增强 (底图 + 矢量注释)" Command="{Binding SetSheetNotesOnlyModeCommand}" />
                        <MenuItem Header="📐 全图 CAD 标注 (底图 + 全量矢量)" Command="{Binding SetAllAnnotationsModeCommand}" />
                        <MenuItem Header="🎨 纯矢量 CAD 视图 (无损无限缩放)" Command="{Binding SetPureVectorCadModeCommand}" />
                    </MenuItem>
                    <Separator Visibility="{Binding HasVectorData, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <MenuItem Header="自适应窗口大小 (Fit)" Command="{Binding FitToWindowCommand}" />
                    <MenuItem Header="1:1 实际尺寸 (100%)" Command="{Binding ResetTo100Command}" />
                    <Separator />
                    <MenuItem Header="放大 (+)" Command="{Binding ZoomInCommand}" />
                    <MenuItem Header="缩小 (-)" Command="{Binding ZoomOutCommand}" />
                    <Separator />
                    <MenuItem Header="导出预览图像..." Command="{Binding ExportImageCommand}" />
                </ContextMenu>
            </Grid.ContextMenu>

            <!-- Image Host with Scale & Translate Transform -->
            <Grid x:Name="TransformHost"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ImgScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ImgTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>

                <Border Background="{StaticResource Brush.Figma.Canvas}"
                        BorderBrush="{StaticResource Brush.Figma.Hairline}"
                        BorderThickness="1" CornerRadius="4"
                        Padding="4">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Direction="270"/>
                    </Border.Effect>

                    <Grid>
                        <Image x:Name="PreviewImageCtrl"
                               Source="{Binding ImageSource}"
                               Stretch="None"
                               Visibility="{Binding IsRasterImageVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                               RenderOptions.BitmapScalingMode="{Binding ScalingMode}" />

                        <!-- Lossless CAD Vector Typography Layer -->
                        <controls:DrawingVectorCanvas
                            Width="{Binding PixelWidth}"
                            Height="{Binding PixelHeight}"
                            VectorData="{Binding VectorData}"
                            OverlayMode="{Binding OverlayMode}"
                            IsOverlayEnabled="{Binding IsVectorOverlayEnabled}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Floating Help Pill -->
            <Border Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{StaticResource Brush.Figma.Canvas}"
                    BorderBrush="{StaticResource Brush.Figma.Hairline}"
                    BorderThickness="1" CornerRadius="12"
                    Padding="12,5" Margin="0,0,16,12"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Opacity="0.88" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.1" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💡 鼠标滚轮缩放 | 拖拽平移 | 双击自适应 | 🔤 CAD 矢量增强" FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.8"/>
                </StackPanel>
            </Border>

            <!-- Empty State (Figma Pastel Card) -->
            <Border Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                    Background="{StaticResource Brush.Figma.BlockCream}"
                    BorderBrush="{StaticResource Brush.Figma.BlockCream}"
                    CornerRadius="16"
                    Padding="36"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Path Data="{StaticResource Geo.Drawing}"
                          Fill="{StaticResource Brush.Figma.Ink}"
                          Opacity="0.4"
                          Width="48" Height="48" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="无可用图像数据" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" HorizontalAlignment="Center" />
                    <TextBlock Text="当前文件未内嵌 2D 缩略图或工程图预览流" FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
