<UserControl x:Class="SldFileViewer.Views.Panels.ImagePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <Grid Background="{StaticResource Brush.Background.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Background.Secondary}"
                BorderBrush="{StaticResource Brush.Border.Primary}"
                BorderThickness="0,0,0,1"
                Padding="10,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Geo.Drawing}"
                          Fill="{StaticResource Brush.Accent.Blue}"
                          Width="14" Height="14" Stretch="Uniform"
                          Margin="0,0,6,0" />
                    <TextBlock Text="2D 图像与图纸预览 (2D Preview)"
                               FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource Brush.Text.Primary}"
                               VerticalAlignment="Center" />

                    <Border Background="{StaticResource Brush.Background.Tertiary}"
                            BorderBrush="{StaticResource Brush.Border.Primary}"
                            BorderThickness="1" CornerRadius="3"
                            Padding="6,2" Margin="12,0,0,0">
                        <TextBlock Text="{Binding ImageInfo}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Image Viewer with ScrollViewer -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource Brush.Viewport.Gradient}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Image Source="{Binding ImageSource}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"
                       MaxWidth="1600" MaxHeight="1200" />

                <!-- Empty State -->
                <StackPanel Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="{StaticResource Geo.Drawing}"
                          Fill="{StaticResource Brush.Text.Muted}"
                          Width="48" Height="48" Stretch="Uniform"
                          HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="无可用图像数据" FontSize="13" Foreground="{StaticResource Brush.Text.Secondary}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
