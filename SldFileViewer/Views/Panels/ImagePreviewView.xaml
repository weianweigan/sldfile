<UserControl x:Class="SldFileViewer.Views.Panels.ImagePreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <Grid Background="{StaticResource Brush.Figma.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header (Figma Canvas + Hairline) -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Figma.Canvas}"
                BorderBrush="{StaticResource Brush.Figma.Hairline}"
                BorderThickness="0,0,0,1"
                Padding="16,8">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{StaticResource Geo.Drawing}"
                          Fill="{StaticResource Brush.Figma.Ink}"
                          Width="14" Height="14" Stretch="Uniform"
                          Margin="0,0,8,0" />
                    <TextBlock Text="2D 图像与图纸预览 (2D Preview)"
                               FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource Brush.Figma.Ink}"
                               VerticalAlignment="Center" />

                    <Border Background="{StaticResource Brush.Figma.BlockLilac}"
                            CornerRadius="10"
                            Padding="12,3" Margin="12,0,0,0">
                        <TextBlock Text="{Binding ImageInfo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Image Viewer with ScrollViewer -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource Brush.Figma.SurfaceCanvas}">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Border Background="{StaticResource Brush.Figma.Canvas}"
                        BorderBrush="{StaticResource Brush.Figma.Hairline}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="8">
                    <Image Source="{Binding ImageSource}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"
                           MaxWidth="1600" MaxHeight="1200" />
                </Border>

                <!-- Empty State (Figma Pastel Card) -->
                <Border Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                        Background="{StaticResource Brush.Figma.BlockCream}"
                        BorderBrush="{StaticResource Brush.Figma.BlockCream}"
                        CornerRadius="16"
                        Padding="36"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource Geo.Drawing}"
                              Fill="{StaticResource Brush.Figma.Ink}"
                              Opacity="0.4"
                              Width="48" Height="48" Stretch="Uniform"
                              HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="无可用图像数据" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" HorizontalAlignment="Center" />
                        <TextBlock Text="当前文件未内嵌 2D 缩略图或工程图预览流" FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.6" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
