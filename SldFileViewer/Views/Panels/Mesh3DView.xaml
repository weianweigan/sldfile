<UserControl x:Class="SldFileViewer.Views.Panels.Mesh3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700">

    <Grid Background="{StaticResource Brush.Background.Primary}">
        <Grid.RowDefinitions>
            <!-- 3D Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 3D Viewport -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar (Figma Canvas + Hairline) -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Figma.Canvas}"
                BorderBrush="{StaticResource Brush.Figma.Hairline}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <DockPanel LastChildFill="False">
                <!-- Title & Stats -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="CubeOutline"
                                                Foreground="{StaticResource Brush.Figma.Ink}"
                                                Width="16" Height="16"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center" />
                    <TextBlock Text="3D 模型网格预览 (DisplayMesh)"
                               FontWeight="Bold" FontSize="13"
                               Foreground="{StaticResource Brush.Figma.Ink}"
                               VerticalAlignment="Center" />

                    <!-- Metrics Badges: Figma Pastel Pills -->
                    <Border Background="{StaticResource Brush.Figma.BlockMint}"
                            CornerRadius="2"
                            Padding="10,3" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="顶点: " FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.7" />
                            <TextBlock Text="{Binding VertexCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" />
                            <TextBlock Text="  面: " FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.7" Margin="4,0,0,0" />
                            <TextBlock Text="{Binding TriangleCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.Figma.BlockLilac}"
                            CornerRadius="2"
                            Padding="10,3" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="边线: " FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.7" />
                            <TextBlock Text="{Binding EdgeCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Brush.Figma.BlockCream}"
                            CornerRadius="2"
                            Padding="10,3" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="包围盒: " FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" Opacity="0.7" />
                            <TextBlock Text="{Binding DimensionsText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Export & View Actions (Figma Pills) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Section View Toggle Button -->
                    <ToggleButton IsChecked="{Binding IsSectionViewEnabled}"
                                  Style="{StaticResource Style.ToggleButton.Toolbar}"
                                  ToolTip="开启/关闭 3D 剖视图 (Cross-Section View)"
                                  Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ContentCut" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="剖视图" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>

                    <ToggleButton IsChecked="{Binding ShowEdges}"
                                  Style="{StaticResource Style.ToggleButton.Toolbar}"
                                  ToolTip="显示/隐藏模型边线 (Wireframe/Edges)"
                                  Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="VectorPolyline" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="边线" FontSize="11"/>
                        </StackPanel>
                    </ToggleButton>

                    <Button Click="OnResetViewClick"
                            Style="{StaticResource Style.Button.Secondary}"
                            Padding="12,4"
                            ToolTip="复位视角 (等轴测视图)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Restore" Foreground="{StaticResource Brush.Figma.Ink}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="复位视角" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{StaticResource Brush.Figma.Hairline}" Margin="8,0" />

                    <Button Command="{Binding ExportObjCommand}"
                            Style="{StaticResource Style.Button.Secondary}"
                            Padding="12,4"
                            ToolTip="导出为 Wavefront OBJ 网格模型">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ExportVariant" Foreground="{StaticResource Brush.Figma.Ink}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="导出 OBJ" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportStlCommand}"
                            Style="{StaticResource Style.Button.Secondary}"
                            Padding="12,4"
                            Margin="6,0,0,0"
                            ToolTip="导出为 STL 3D 打印三角网格">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Printer3d" Foreground="{StaticResource Brush.Figma.Ink}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="导出 STL" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportGlbCommand}"
                            Style="{StaticResource Style.Button.Secondary}"
                            Padding="12,4"
                            Margin="6,0,0,0"
                            ToolTip="导出为 glTF 2.0 二进制模型 (.glb，适用 Web 3D / Three.js / Windows 3D 查看器)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Earth" Foreground="{StaticResource Brush.Figma.Ink}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="导出 GLB" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ExportParasolidCommand}"
                            Visibility="{Binding HasParasolid, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource Style.Button.Secondary}"
                            Padding="12,4"
                            Margin="6,0,0,0"
                            ToolTip="提取原始 Parasolid Transmit 几何内核数据 (.x_b)">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="CodeJson" Foreground="{StaticResource Brush.Figma.Ink}" Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="导出 Parasolid (.x_b)" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Viewport3D Area -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Viewport.Gradient}">
            <Grid x:Name="ViewportContainer"
                  Background="Transparent"
                  ClipToBounds="True"
                  Focusable="True"
                  MouseDown="OnViewportMouseDown"
                  MouseMove="OnViewportMouseMove"
                  MouseUp="OnViewportMouseUp"
                  MouseWheel="OnViewportMouseWheel">

                <!-- 3D Viewport with CAD Standard Orthographic Camera -->
                <Viewport3D x:Name="MainViewport">
                    <Viewport3D.Camera>
                        <OrthographicCamera x:Name="Camera"
                                            Position="150,150,200"
                                            LookDirection="-150,-150,-200"
                                            UpDirection="0,1,0"
                                            Width="200" />
                    </Viewport3D.Camera>

                    <!-- Lighting -->
                    <ModelVisual3D>
                        <ModelVisual3D.Content>
                            <Model3DGroup>
                                <AmbientLight Color="#707070" />
                                <DirectionalLight Color="#FFFFFF" Direction="-1,-2,-3" />
                                <DirectionalLight Color="#808090" Direction="1,2,3" />
                                <DirectionalLight Color="#404050" Direction="0,-1,0" />
                            </Model3DGroup>
                        </ModelVisual3D.Content>
                    </ModelVisual3D>

                    <!-- Model Geometry Visual -->
                    <ModelVisual3D x:Name="ModelVisual" />
                    <!-- Model Edge Lines Visual (OutlineEdges) -->
                    <ModelVisual3D x:Name="EdgeVisual" />
                    <!-- Section Cut Outlines Visual (High-contrast Cut Lines) -->
                    <ModelVisual3D x:Name="SectionCutVisual" />
                    <!-- Section Cutting Plane Visual (Semi-transparent Plane) -->
                    <ModelVisual3D x:Name="SectionPlaneVisual" />
                    <!-- Section Cutting Plane Border Visual (Wireframe Line) -->
                    <ModelVisual3D x:Name="SectionBorderVisual" />
                    <!-- Section Manipulator Handle Visual -->
                    <ModelVisual3D x:Name="SectionManipulatorVisual" />
                </Viewport3D>

                <!-- Section View Floating Control Toolbar -->
                <Border Visibility="{Binding IsSectionViewEnabled, Converter={StaticResource BoolToVisibilityConverter}}"
                        HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,14,0,0"
                        Background="#F0FFFFFF"
                        BorderBrush="{StaticResource Brush.Figma.Hairline}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="14,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ContentCut" Foreground="{StaticResource Brush.Accent.Orange}"
                                                    Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="剖切方向:" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Figma.Ink}" VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <RadioButton Content="X 轴 (YZ面)" IsChecked="{Binding IsAxisX}"
                                     FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>
                        <RadioButton Content="Y 轴 (XZ面)" IsChecked="{Binding IsAxisY}"
                                     FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" Cursor="Hand"/>
                        <RadioButton Content="Z 轴 (XY面)" IsChecked="{Binding IsAxisZ}"
                                     FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" Cursor="Hand"/>

                        <Rectangle Width="1" Height="16" Fill="{StaticResource Brush.Figma.Hairline}" Margin="0,0,12,0"/>

                        <TextBlock Text="位置:" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Figma.Ink}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Slider Minimum="-100" Maximum="100" Value="{Binding SectionOffsetPercent}"
                                Width="130" VerticalAlignment="Center" Cursor="Hand" />
                        <TextBlock Text="{Binding SectionOffsetDisplay}" FontSize="11" FontFamily="Consolas, Segoe UI Mono"
                                   FontWeight="SemiBold" Foreground="{StaticResource Brush.Figma.Ink}" Width="65"
                                   TextAlignment="Right" VerticalAlignment="Center" Margin="6,0,10,0"/>

                        <Button Command="{Binding ToggleSectionInvertCommand}"
                                Style="{StaticResource Style.Button.Secondary}"
                                Padding="8,2" Height="24"
                                ToolTip="反转剖切截面保留方向">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="FlipHorizontal" Width="10" Height="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="反向" FontSize="10"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ResetSectionOffsetCommand}"
                                Style="{StaticResource Style.Button.Secondary}"
                                Padding="8,2" Height="24" Margin="6,0,0,0"
                                ToolTip="复位剖切平面至中心位置 (0 mm)">
                            <TextBlock Text="居中" FontSize="10"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Floating Help Overlay (Figma Pill) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="16"
                        Background="#E6FFFFFF"
                        BorderBrush="{StaticResource Brush.Figma.Hairline}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,5">
                    <TextBlock Text="中键拖拽旋转 (或左键) | Ctrl+中键/右键平移 | 滚轮缩放 | 剖视图开启时鼠标可直接拖拽剖切面"
                               FontFamily="Consolas, Cascadia Code, Segoe UI"
                               FontSize="11" Foreground="{StaticResource Brush.Figma.Ink}" />
                </Border>

                <!-- Empty State Notice Banner (Figma Pastel Pink Pill) -->
                <Border Visibility="{Binding HasMesh, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"
                        VerticalAlignment="Top" HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        Background="{StaticResource Brush.Figma.BlockPink}"
                        BorderBrush="{StaticResource Brush.Figma.BlockPink}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="AlertCircleOutline"
                                                    Foreground="{StaticResource Brush.Figma.Ink}"
                                                    Width="14" Height="14"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center" />
                        <TextBlock Text="当前模型流中未检测到 3D 网格数据 (DisplayLists)"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource Brush.Figma.Ink}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
