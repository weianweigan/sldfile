<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <PlatformTarget>x64</PlatformTarget>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <SolidWorksInstallDir Condition="'$(SolidWorksInstallDir)' == ''">C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SolidWorksInstallDir>
        <FallbackInteropDir>$(MSBuildThisFileDirectory)..\reverse_workspace\tools\SketchLab\bin\Debug\net8.0-windows</FallbackInteropDir>
        <HasSolidWorksInterop Condition="Exists('$(SolidWorksInstallDir)\api\redist\SolidWorks.Interop.sldworks.dll') Or Exists('$(FallbackInteropDir)\SolidWorks.Interop.sldworks.dll')">true</HasSolidWorksInterop>
        <HasSolidWorksInterop Condition="'$(HasSolidWorksInterop)' == ''">false</HasSolidWorksInterop>
    </PropertyGroup>

    <ItemGroup Condition="'$(HasSolidWorksInterop)' == 'true'">
        <Reference Include="SolidWorks.Interop.sldworks">
            <HintPath Condition="Exists('$(SolidWorksInstallDir)\api\redist\SolidWorks.Interop.sldworks.dll')">$(SolidWorksInstallDir)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
            <HintPath Condition="!Exists('$(SolidWorksInstallDir)\api\redist\SolidWorks.Interop.sldworks.dll')">$(FallbackInteropDir)\SolidWorks.Interop.sldworks.dll</HintPath>
            <EmbedInteropTypes>false</EmbedInteropTypes>
        </Reference>
        <Reference Include="SolidWorks.Interop.swconst">
            <HintPath Condition="Exists('$(SolidWorksInstallDir)\api\redist\SolidWorks.Interop.swconst.dll')">$(SolidWorksInstallDir)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
            <HintPath Condition="!Exists('$(SolidWorksInstallDir)\api\redist\SolidWorks.Interop.swconst.dll')">$(FallbackInteropDir)\SolidWorks.Interop.swconst.dll</HintPath>
            <EmbedInteropTypes>false</EmbedInteropTypes>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="'$(HasSolidWorksInterop)' != 'true'">
        <Compile Remove="**\*.cs" />
    </ItemGroup>

    <Target Name="WarnNoSolidWorks" BeforeTargets="BeforeBuild" Condition="'$(HasSolidWorksInterop)' != 'true'">
        <Warning Text="未检测到 SolidWorks COM Interop 组件 ('$(SolidWorksInstallDir)\api\redist')。已跳过需要 SolidWorks 运行环境的 COM 集成测试。" />
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0"/>
        <PackageReference Include="xunit" Version="2.5.3"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SldFile\SldFile.csproj" />
    </ItemGroup>

</Project>
